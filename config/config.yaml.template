# ============================================================================
# FireSpot V3.0 - DeerFlow 配置模板
# ============================================================================
# 此文件需要合并到您的 DeerFlow 项目的 config.yaml 中
# ============================================================================

# ============================================================================
# MCP 服务器配置
# ============================================================================
mcp:
  servers:
    # 微信公众号发布 MCP 服务器
    - name: wechat-publisher
      type: sse                             # 使用 SSE 传输
      url: http://localhost:3101/sse        # 微信 MCP 服务端口
      enabled: true
      description: "FireSpot 微信公众号发布服务器"
      tools:
        - mcp_wechat_upload_media
        - mcp_wechat_create_draft
        - mcp_wechat_publish
        - mcp_wechat_get_status

    # 小红书发布 MCP 服务器（可选，需要第三方服务）
    - name: xhs-publisher
      type: sse
      url: http://localhost:3102/sse
      enabled: false
      description: "FireSpot 小红书发布服务器（需要第三方API）"
      tools:
        - mcp_xhs_create_note
        - mcp_xhs_get_status

    # 抖音发布 MCP 服务器（可选，需要第三方服务）
    - name: douyin-publisher
      type: sse
      url: http://localhost:3103/sse
      enabled: false
      description: "FireSpot 抖音发布服务器（需要第三方API）"
      tools:
        - mcp_douyin_init_upload
        - mcp_douyin_create_post
        - mcp_douyin_get_status

